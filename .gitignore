# vendored Neovim builds (created by python -m release_tool fetch)
src/nvim_bin/_nvim/*
!src/nvim_bin/_nvim/.gitkeep
# Neovim's license travels with every wheel, so it is tracked in git:
# one copy per supported release line
!src/nvim_bin/_nvim/LICENSE.nvim-*.txt

# build artifacts
build/
dist/
wheelhouse/
*.egg-info/
src/*.egg-info/
.eggs/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
